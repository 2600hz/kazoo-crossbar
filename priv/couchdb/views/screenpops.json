{
    "_id": "_design/screenpops",
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "config_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'screenpops' || doc.pvt_deleted) return;",
                "  emit(doc._id, {",
                "    'id': doc._id,",
                "    'custom_parameters': doc.custom_parameters,",
                "    'post_call_extension_time': doc.post_call_extension_time,",
                "    'type_screenpops': doc.type_screenpops,",
                "    'show_location_call_time': doc.show_location_call_time",
                "  });",
                "}"
            ]
        }
    }
}
