{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "system_config.callflow.menu",
    "description": "Schema for callflow.menu system_config",
    "properties": {
        "max_wait_for_attachments_ms": {
            "default": 5000,
            "description": "callflow menu max_wait_for_attachments_ms",
            "type": "integer"
        },
        "min_greeting_length": {
            "default": 1500,
            "description": "callflow.menu minimum greeting length",
            "type": "integer"
        },
        "stop_after_extension": {
            "default": false,
            "description": "If false, when calling into a menu that has a default action set and the caller dials an extension, caller will be redirected to parent's default action after extension hangs up",
            "support_level": "supported",
            "type": "boolean"
        }
    },
    "type": "object"
}
