{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "match_lists.rule",
    "description": "Match list rule - express the logic of a match",
    "properties": {
        "name": {
            "description": "Friendly name of the rule",
            "maxLength": 255,
            "minLength": 3,
            "type": "string"
        },
        "type": {
            "enum": [
                "regex",
                "and",
                "not",
                "temporal_rules_set",
                "temporal_route"
            ],
            "kazoo-validation": true,
            "type": "string"
        }
    },
    "required": [
        "type"
    ],
    "type": "object"
}
