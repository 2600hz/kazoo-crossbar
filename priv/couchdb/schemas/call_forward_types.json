{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "call_forward_types",
    "additionalProperties": false,
    "properties": {
      "busy": {
        "$ref": "call_forward_type",
        "type": "object"
      },
      "no_answer": {
        "$ref": "call_forward_type",
        "type": "object"
      },
      "selective": {
        "description": "Conditionally check match lists to determine if call forwarding should be used",
        "default": {
          "enabled": false
        },
        "properties": {
          "direct_calls_only": {
            "default": false,
            "type": "boolean"
          },
          "enabled": {
            "default": false,
            "type": "boolean"
          },
          "ignore_early_media": {
            "default": true,
            "type": "boolean"
          },
          "keep_caller_id": {
            "default": true,
            "type": "boolean"
          },
          "number": {
            "maxLength": 35,
            "type": "string"
          },
          "require_keypress": {
            "default": true,
            "type": "boolean"
          },
          "rules": {
            "description": "Match list rules to check for call forwarding",
            "items": {
              "properties": {
                "direct_calls_only": {
                  "default": false,
                  "type": "boolean"
                },
                "enabled": {
                  "default": false,
                  "type": "boolean"
                },
                "ignore_early_media": {
                  "default": true,
                  "type": "boolean"
                },
                "keep_caller_id": {
                  "default": true,
                  "type": "boolean"
                },
                "number": {
                  "maxLength": 35,
                  "type": "string"
                },
                "require_keypress": {
                  "default": true,
                  "type": "boolean"
                },
                "match_id_list": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "type": "object"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "unconditional": {
        "$ref": "call_forward_type",
        "type": "object"
      }
    },
    "required": [
      "enabled"
    ],
    "type": "object"
}
