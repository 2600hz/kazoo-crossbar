{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "scope_restrictions",
    "description": "Auth Scope Restrictions Definition",
    "properties": {
        "description": {
            "description": "Scope description",
            "type": "string"
        },
        "http": {
            "description": "Token Restrictions to enforce for HTTP/HTTPS transport protocol",
            "properties": {
                "allow": {
                    "patternProperties": {
                        "^(GET|PUT|POST|PATCH|DELETE|_)$": {
                            "description": "URL paths",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        }
                    }
                },
                "deny": {
                    "patternProperties": {
                        "^(GET|PUT|POST|PATCH|DELETE|_)$": {
                            "description": "URL paths",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        }
                    }
                }
            }
        },
        "precedence": {
            "default": "allow",
            "description": "If scope restriction request matches both allow and deny rules which one should take precedence",
            "enum": [
                "allow",
                "deny"
            ],
            "type": "string"
        },
        "scope_name": {
            "description": "Name of scope this restriction is applying to",
            "type": "string"
        }
    },
    "required": [
        "scope_name"
    ],
    "type": "object"
}
