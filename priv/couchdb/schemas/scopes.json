{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "scopes",
    "description": "Kazoo Auth Scope Definition",
    "properties": {
        "allow_api_request": {
            "description": "Indicates this scope can be requested from API",
            "type": "boolean"
        },
        "description": {
            "description": "Scope description",
            "type": "string"
        },
        "id": {
            "description": "Id (name) of scope",
            "type": "string"
        },
        "scopes": {
            "default": [],
            "description": "List of available subscopes",
            "items": {
                "type": "string"
            },
            "type": "array"
        }
    },
    "required": [
        "allow_api_request",
        "id"
    ],
    "type": "object"
}
