{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "scopes",
    "description": "Kazoo Auth Scope Definition",
    "properties": {
        "description": {
            "description": "Scope description",
            "type": "string"
        },
        "id": {
            "description": "Id of scope",
            "type": "string"
        },
        "name": {
            "description": "Name of scope",
            "type": "string"
        },
        "permissions": {
            "description": "Specifies who can request using this scope, values are '{ACCOUNT_TYPE}:{USER_TYPE_OR_STAR}. ACCOUNT_TYPE can be 'master', 'reseller', 'non-reseller'. USER_TYPE can be 'user', 'admin' or '*' as catch all",
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "scopes": {
            "default": [],
            "description": "List of subscopes",
            "items": {
                "type": "string"
            },
            "type": "array"
        }
    },
    "required": [
        "id",
        "permissions"
    ],
    "type": "object"
}
