{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "callflows.pivot",
    "description": "Validator for the Pivot callflow element",
    "oneOf": [
        {
            "properties": {
                "id": {
                    "description": "Document id that defines the pivot flow",
                    "type": "string"
                },
                "skip_module": {
                    "description": "When set to true, this callflow action is skipped, advancing to the wildcard branch (if any).",
                    "type": "boolean"
                }
            },
            "required": [
                "id"
            ],
            "type": "object"
        },
        {
            "allOf": [
                {
                    "$ref": "pivot"
                },
                {
                    "properties": {
                        "skip_module": {
                            "description": "When set to true, this callflow action is skipped, advancing to the wildcard branch (if any).",
                            "type": "boolean"
                        }
                    },
                    "type": "object"
                }
            ]
        }
    ]
}
