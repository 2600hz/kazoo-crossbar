{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "trunkingio_im",
    "description": "Schema for sms/mms document from TrunkingIO",
    "properties": {
        "delivery_receipt": {
            "description": "Always false.",
            "type": "boolean"
        },
        "from": {
            "description": "caller-id-number",
            "type": "string"
        },
        "media_urls": {
            "description:": "links to message content for mms messages, including any text. `null` for sms",
            "items": {
                "type": "string"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "other_recipients": {
            "description": "other recipients, delivery handled separately",
            "items": {
                "type": "string"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "received_at": {
            "description": "ISO 8601 date and time to six decimals:  yyyy-mm-ddThh:mm:ss.ssssssZ",
            "type": "string"
        },
        "reference_id": {
            "description": "TIO reference ID",
            "type": "string"
        },
        "text": {
            "description": "message body for sms messages. `null` for mms",
            "type": [
                "string",
                "null"
            ]
        },
        "to": {
            "description": "callee-id-number",
            "type": "string"
        }
    },
    "required": [
        "to",
        "from"
    ],
    "type": "object"
}
